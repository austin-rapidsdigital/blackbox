## Blackbox recommended audit rules for Ubuntu 22.04/24.04 and AlmaLinux 8.
## Based on the DISA STIG rules for these systems; they record everything the
## Blackbox report needs.
##
## Install (as root):
##   blackbox check --audit-rules > /etc/audit/rules.d/99-blackbox.rules
##   augenrules --load
## Review against your site's STIG checklist before use.

## Larger kernel buffer, so busy systems do not drop audit records.
-b 8192

## Account database edits (Account & Group Changes).
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity

## Changes to who may use sudo (Privileged Activity).
-w /etc/sudoers -p wa -k privilege_modification
-w /etc/sudoers.d/ -p wa -k privilege_modification

## Programs that run with raised privileges, e.g. passwd, chage (Privileged Activity).
-a always,exit -F arch=b64 -S execve -C uid!=euid -F euid=0 -k execpriv
-a always,exit -F arch=b32 -S execve -C uid!=euid -F euid=0 -k execpriv
-a always,exit -F arch=b64 -S execve -C gid!=egid -F egid=0 -k execpriv
-a always,exit -F arch=b32 -S execve -C gid!=egid -F egid=0 -k execpriv

## Commands a person runs as root, including inside root shells (sudo -i, su).
-a always,exit -F arch=b64 -S execve -F euid=0 -F auid>=1000 -F auid!=unset -k root_commands
-a always,exit -F arch=b32 -S execve -F euid=0 -F auid>=1000 -F auid!=unset -k root_commands

## Kernel modules loaded or removed (Other Security Events).
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k module_chng
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k module_chng

## Filesystems mounted by a person (USB & Removable Media).
-a always,exit -F arch=b64 -S mount,umount2 -F auid>=1000 -F auid!=unset -k privileged-mount
-a always,exit -F arch=b32 -S mount,umount2 -F auid>=1000 -F auid!=unset -k privileged-mount

## System time changed by a person (Audit & System Integrity). Limited to
## logged-in users so time synchronisation daemons do not flood the log.
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -F auid>=1000 -F auid!=unset -k time-change
-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime -F auid>=1000 -F auid!=unset -k time-change
-w /etc/localtime -p wa -k time-change

## Log files deleted or changed by a person (Audit & System Integrity).
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat,truncate,ftruncate -F dir=/var/log -F auid>=1000 -F auid!=unset -k log_tamper
-a always,exit -F arch=b32 -S unlink,unlinkat,rename,renameat,truncate,ftruncate -F dir=/var/log -F auid>=1000 -F auid!=unset -k log_tamper

## Logon records.
-w /var/log/lastlog -p wa -k logins
-w /var/run/faillock -p wa -k logins

## Audit configuration and tools.
-w /etc/audit/ -p wa -k auditconfig
-w /usr/sbin/auditctl -p x -k audittools
-w /usr/sbin/auditd -p x -k audittools
-w /usr/sbin/augenrules -p x -k audittools

## Lock the rules until reboot (the STIG requires this; it must be last).
-e 2
